+"""Validate generated Human3.6M canonical .npz files.
+
+Computes for each file:
+* mean/max reprojection error (px)
+* self-consistency MPJPE between stored joints_3d and a fresh DLT triangulation
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+import sys
+sys.path.insert(0, str(Path(__file__).parent.parent))
+
+from motionflow_mv.calibration.camera import Camera
+from motionflow_mv.fusion.triangulation import triangulate_dlt
+
+
+def validate_file(npz_path: Path) -> dict:
+    npz = np.load(npz_path)
+    points_2d = npz["points_2d"]
+    joints_3d = npz["joints_3d"]
+    camera_K = npz["camera_K"]
+    camera_R = npz["camera_R"]
+    camera_t = npz["camera_t"]
+
+    T, V, J, _ = points_2d.shape
+    cameras = [Camera(K=camera_K[v], R=camera_R[v], t=camera_t[v]) for v in range(V)]
+    P = np.stack([cam.projection_matrix for cam in cameras], axis=0)
+
+    reproj_errors = []
+    mpjpe_errors = []
+    for t in range(T):
+        p2d = points_2d[t]
+        X_stored = joints_3d[t]
+
+        # reprojection
+        err = 0.0
+        for v, cam in enumerate(cameras):
+            X_cam = (cam.R @ X_stored.T + cam.t.reshape(3, 1)).T
+            proj = (cam.K @ X_cam.T).T
+            proj = proj[:, :2] / proj[:, 2:3]
+            err += np.linalg.norm(proj - p2d[v], axis=-1).mean()
+        reproj_errors.append(err / V)
+
+        # fresh DLT vs stored
+        X_dlt = np.zeros((J, 3), dtype=np.float64)
+        for j in range(J):
+            X_dlt[j] = triangulate_dlt(p2d[:, j, :], P)
+        mpjpe_errors.append(np.linalg.norm(X_dlt - X_stored, axis=-1).mean())
+
+    return {
+        "frames": T,
+        "mean_reproj_px": float(np.mean(reproj_errors)),
+        "max_reproj_px": float(np.max(reproj_errors)),
+        "mean_mpjpe_mm": float(np.mean(mpjpe_errors)),
+        "max_mpjpe_mm": float(np.max(mpjpe_errors)),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dir", type=str, default="data/webbridge/h36m_corrected")
+    parser.add_argument("--subjects", type=int, nargs="+", default=[9, 11])
+    args = parser.parse_args()
+
+    base = Path(args.dir)
+    if not base.exists():
+        raise FileNotFoundError(base)
+
+    rows = []
+    for subj in args.subjects:
+        for npz_path in sorted(base.glob(f"s_{subj:02d}_acts_*_multiview.npz")):
+            metrics = validate_file(npz_path)
+            row = {"file": npz_path.name, **metrics}
+            rows.append(row)
+            print(json.dumps(row))
+
+    if rows:
+        print("\nSummary:")
+        print(f"  files: {len(rows)}")
+        print(f"  mean reprojection: {np.mean([r['mean_reproj_px'] for r in rows]):.2f} px")
+        print(f"  max reprojection:  {np.max([r['max_reproj_px'] for r in rows]):.2f} px")
+        print(f"  mean MPJPE:        {np.mean([r['mean_mpjpe_mm'] for r in rows]):.6f} mm")
+        print(f"  max MPJPE:         {np.max([r['max_mpjpe_mm'] for r in rows]):.6f} mm")
+
+
+if __name__ == "__main__":
+    main()
