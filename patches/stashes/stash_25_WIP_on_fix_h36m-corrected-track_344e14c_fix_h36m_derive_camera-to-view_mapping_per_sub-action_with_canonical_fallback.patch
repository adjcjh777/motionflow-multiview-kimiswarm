-def _load_list(path, dtype):
-    with open(path) as f:
-        return [dtype(x.strip()) for x in f.read().strip().split(",") if x.strip()]
-
-
-def _load_pairs(path):
-    out = []
-    with open(path) as f:
-        for line in f:
-            line = line.strip()
-            if not line:
-                continue
-            a, b = line.split(",")
-            out.append((int(a.strip()), int(b.strip())))
-    return out
-
