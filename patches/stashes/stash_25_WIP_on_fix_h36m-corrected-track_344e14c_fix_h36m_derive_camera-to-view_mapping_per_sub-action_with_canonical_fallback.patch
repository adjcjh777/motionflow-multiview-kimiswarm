+
+    all_p2d = []
+    all_conf = []
+    all_j3d = []
+
+    for target_base in target_bases:
+        cams_dict = groups[target_base]
+        cam_names = sorted(cams_dict.keys(), key=lambda c: cams_dict[c][0])
+        n_frames = len(cams_dict[cam_names[0]])
+        print(f"Processing {target_base}: {n_frames} frames")
+
+        fixed_names = [camera_name_for_suffix(c) for c in cam_names]
+        derived_names = derive_mapping(cams_dict)
+        if derived_names == fixed_names:
+            current_camera_names = derived_names
+        else:
+            current_camera_names = fixed_names
+
+        current_cameras = build_cameras(current_camera_names)
+        perm = [current_camera_names.index(name) for name in canonical_camera_names]
+
+        for frame in range(n_frames):
+            p2d_list = [split_data["joint_2d"][cams_dict[cam][frame]] for cam in cam_names]
