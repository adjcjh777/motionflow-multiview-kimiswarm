+    def camera_name_for_suffix(cam_full: str) -> str:
+        suffix = cam_full.split("_")[-1]
+        return {"01": "54138969", "02": "55011271", "03": "58860488", "04": "60457274"}[suffix]
+
+    def build_cameras(camera_names):
+        cams = []
+        for name in camera_names:
+            intr = cam_params["intrinsics"][name]["calibration_matrix"]
