+name: Smoke Tests
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+
+jobs:
+  smoke:
+    runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        python-version: ["3.10"]
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Python ${{ matrix.python-version }}
+        uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+          cache: "pip"
+
+      - name: Install CPU torch + dependencies
+        run: |
+          python -m pip install --upgrade pip
+          # Install CPU-only torch so the CUDA wheel in requirements.txt is skipped.
+          pip install torch --index-url https://download.pytorch.org/whl/cpu
+          # Install remaining requirements, ignoring the pinned torch wheel.
+          sed '/^torch==/d' requirements.txt > /tmp/requirements-ci.txt
+          pip install -r /tmp/requirements-ci.txt
+
+      - name: Run smoke tests
+        run: |
+          export PYTHONPATH=$PWD
+          pytest tests/test_multiview_geometry_fusion_v25.py -q
+          pytest tests/test_auto_eval_when_ready.py -q
