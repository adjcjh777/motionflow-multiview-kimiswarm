+#!/usr/bin/env bash
+# Local RTX 4090 smoke test for v48 domain generalization on top of the v46/v47 stack.
+# Run only when the GPU is free (do not overlap with other training).
+set -euo pipefail
+
+python -u experiments/train_omniview_fusion_v5_webbridge_multi.py \
+    --use_mixed_loader \
+    --mixed_manifest configs/splits/webbridge_h36m_mpi_mixed_train_val.yaml \
+    --use_domain_embedding \
+    --use_deformable_cross_view_attention_v18 \
+    --use_multiview_geometry_fusion_v25 \
