+def test_adaptive_per_joint_learnable_shifts():
+    """Adaptive detector should down-weight a corrupted view and expose per-joint parameters."""
+    J = 17
+    detector = OutlierViewDetector(z_thresh=2.0, soft_beta=2.0, num_joints=J, adaptive=True)
+    X, points_2d, K, R, t, view_mask = _make_batch(V=4, J=J)
+    weights, _ = detector(X, points_2d, K, R, t, view_mask=view_mask)
+    assert weights.shape == (2, 3, 4, J)
+    # On clean data all weights should be near one because the gate is zero.
+    assert torch.allclose(weights, torch.ones_like(weights), atol=1e-5)
+
+    points_2d_corrupt = points_2d.clone()
+    points_2d_corrupt[:, :, 0, :, :] += 100.0
+    weights_corrupt, _ = detector(X, points_2d_corrupt, K, R, t, view_mask=view_mask)
+    assert weights_corrupt[:, :, 0, :].mean() < weights_corrupt[:, :, 1, :].mean()
+
+    # Per-joint shift parameters should receive gradients.
+    loss = weights_corrupt.mean()
+    loss.backward()
+    assert detector.z_shift.grad is not None
+    assert detector.beta_shift.grad is not None
+
+
